# OpenWrt's build configuration for the image, as far as it differs from what the device
# gets by default. build.sh hands it to `make defconfig`, which fills in the rest, and
# stops when a line here did not make it into the result.
#
# Kernel and root file system have to fit the 5,952 KB firmware partition, and what they
# leave of it holds the settings; see "Size" in the README for what each change saves.

# --- The device

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_tplink_tl-wpa7510-v2=y

# --- What a bridged extender does without

# IPv6, in the kernel and the packages. Needs patches/0001.
# CONFIG_IPV6 is not set
# Package manager, its signing keys and certificates, and with them the TLS library;
# packages come with a flash
# CONFIG_PACKAGE_apk-mbedtls is not set
# CONFIG_SIGNED_PACKAGES is not set
# CONFIG_PACKAGE_usign is not set
# CONFIG_PACKAGE_openwrt-keyring is not set
# CONFIG_PACKAGE_ca-bundle is not set
# CONFIG_PACKAGE_uclient-fetch is not set
# CONFIG_PACKAGE_libustream-mbedtls is not set
# DHCP and DNS server, firewall, IPv6 address services: the main router does those
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_nftables-json is not set
# CONFIG_PACKAGE_kmod-nft-offload is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_odhcp6c is not set
# Dial-up internet
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# Extra randomness at startup; the kernel's own is ready during the boot
# CONFIG_PACKAGE_urngd is not set
# Kernel debugging, swap, core dumps, key rings, BPF for control groups, RDMA, multipath
# TCP and multicast routing, which nothing on the image uses
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_KERNEL_MAGIC_SYSRQ is not set
# CONFIG_KERNEL_SWAP is not set
# CONFIG_KERNEL_ELF_CORE is not set
# CONFIG_KERNEL_KEYS is not set
# CONFIG_KERNEL_CGROUP_BPF is not set
# CONFIG_KERNEL_CGROUP_RDMA is not set
# CONFIG_KERNEL_MPTCP is not set
# CONFIG_KERNEL_IP_MROUTE is not set

# --- Wi-Fi

# Access points with WPA2 only, which needs no crypto library; WPA2/WPA3 would take
# hostapd-basic-mbedtls and mbedtls
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_hostapd-mini=y
# Mesh networks and the Wi-Fi stack's debugging files
# CONFIG_PACKAGE_MAC80211_MESH is not set
# CONFIG_PACKAGE_MAC80211_DEBUGFS is not set

# --- SSH

# Ed25519 keys only: no RSA, ECDSA or security keys, nor the older key exchange. The
# client and agent forwarding go too, which an extender does not use.
# CONFIG_DROPBEAR_RSA is not set
# CONFIG_DROPBEAR_ECDSA is not set
# CONFIG_DROPBEAR_SK_KEYS is not set
# CONFIG_DROPBEAR_DH_GROUP14_SHA256 is not set
# CONFIG_DROPBEAR_DBCLIENT is not set
# CONFIG_DROPBEAR_SVR_AGENTFWD is not set

# --- Command-line tools no script on the image uses

CONFIG_BUSYBOX_CUSTOM=y
# CONFIG_BUSYBOX_CONFIG_CROND is not set
# CONFIG_BUSYBOX_CONFIG_CRONTAB is not set
# CONFIG_BUSYBOX_CONFIG_TRACEROUTE is not set
# CONFIG_BUSYBOX_CONFIG_TRACEROUTE6 is not set
# CONFIG_BUSYBOX_CONFIG_PING6 is not set
# CONFIG_BUSYBOX_CONFIG_NC is not set
# CONFIG_BUSYBOX_CONFIG_LESS is not set
# CONFIG_BUSYBOX_CONFIG_TIME is not set

# --- Booting an image from memory over SSH, to try it before flashing
# kexec: the kernel's support for starting another kernel, and the tool
CONFIG_KERNEL_KEXEC=y
CONFIG_PACKAGE_kexec=y
