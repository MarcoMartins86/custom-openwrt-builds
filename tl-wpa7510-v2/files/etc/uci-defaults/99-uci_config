# https://openwrt.org/docs/guide-developer/uci-defaults#integrating_custom_settings
# A bridged extender: the Ethernet socket, the powerline and both Wi-Fi networks join the
# main router's network, which hands out the addresses. Its devices show up there like any
# other. Nothing here routes, filters or hands out addresses.
#
# The Ethernet socket and the powerline are both behind the powerline chip, which bridges
# them with the chip's link to the SoC, eth0: OpenWrt's LAN bridge over eth0 is all it
# takes.
. /etc/build.env
uci -q batch << EOI
delete network.globals.ula_prefix
delete network.lan.ip6assign
set network.lan.proto='static'
delete network.lan.ipaddr
delete network.lan.netmask
add_list network.lan.ipaddr='${LAN_ADDRESS}'
set network.lan.gateway='${GATEWAY}'
delete network.lan.dns
add_list network.lan.dns='${GATEWAY}'
commit network
set system.@system[0].hostname='${AP_NAME}'
set system.@system[0].zonename='${TIMEZONE}'
set system.@system[0].timezone='${TIMEZONE_RULE}'
commit system
EOI
# With a key to log in with, SSH takes nothing else
if [ -s /etc/dropbear/authorized_keys ]; then
	uci -q batch << EOI
set dropbear.main.PasswordAuth='off'
set dropbear.main.RootPasswordAuth='off'
commit dropbear
EOI
fi
