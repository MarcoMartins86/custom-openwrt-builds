# Kernel options on top of those OpenWrt builds the device's kernel with. build.sh appends
# them to the kernel configuration of OpenWrt's mt7620 devices in the source, and stops when
# one did not make it into the kernel's configuration.

# Programs loaded into the kernel; nothing on the image uses them
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# ethtool's newer interface; netifd uses the older one
# CONFIG_ETHTOOL_NETLINK is not set
# System V shared memory and semaphores. POSIX message queues stay: without either, the
# kernel has no IPC namespaces, and the sandbox that runs ntpd and hostapd (ujail) fails.
# CONFIG_SYSVIPC is not set
# Parallel flash chips; this device has a serial one
# CONFIG_MTD_CFI is not set
# CONFIG_MTD_JEDECPROBE is not set
# CONFIG_MTD_COMPLEX_MAPPINGS is not set
# CONFIG_MTD_PHYSMAP is not set
# Firmware layouts of other vendors; this device's is TP-Link's
# CONFIG_MTD_SPLIT_SEAMA_FW is not set
# CONFIG_MTD_SPLIT_UIMAGE_FW is not set
# CONFIG_MTD_SPLIT_JIMAGE_FW is not set
# Voltage regulators, which only the SoC's SD card interface uses, and USB, which this
# device has neither of
# CONFIG_REGULATOR is not set
# CONFIG_REGULATOR_FIXED_VOLTAGE is not set
# CONFIG_PHY_RALINK_USB is not set
# Multicast snooping in the bridge, which netifd leaves off by default anyway, policy
# routing, and disk partition tables
# CONFIG_BRIDGE_IGMP_SNOOPING is not set
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_MSDOS_PARTITION is not set
# CONFIG_EFI_PARTITION is not set
# Only the exports the image's modules use, listed in ksyms-keep.txt (build.sh adds its
# path). The image has no package manager, so no other module comes to need one.
CONFIG_TRIM_UNUSED_KSYMS=y

# What has to stay, unlike on smaller builds:
# - the initial RAM disk: the image that boots from memory, for tests and recovery, is one
# - GPIOs from user space: the LED switch is handed to user space that way
#   (gpio-export in the device tree), and brings the character device along
# - VLANs: the bridge's VLAN filtering depends on them, and netifd makes no bridge without
#   that filtering
