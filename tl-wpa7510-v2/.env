# Everything that can be chosen about the image. docker-compose.yml, build.sh and flash.sh
# read this file. Your own values, and anything private, go into private/.env, which
# overrides this file and is not in the repo.
#
# The format has to suit both the shell and Docker Compose: NAME=value with no spaces around
# the "=", and double quotes around a value that contains spaces. A password goes in single
# quotes: unquoted, the shell acts on characters such as & ; | and spaces, and inside double
# quotes still on $, \ and backticks. A ' in it is written '\''.

# --- Build

# OpenWrt does not support this device yet. The image is built from a fork of OpenWrt's
# source that adds it, at a fixed commit of the branch with the port, so that two builds
# of it are the same. Its version is OpenWrt's development version at that point.
OPENWRT_GIT=https://github.com/MarcoMartins86/openwrt.git
OPENWRT_BRANCH=ramips-tl-wpa7510-v2
OPENWRT_COMMIT=8815a7c989bc9bfee40461fe731c8c8a55800243

# OpenWrt's SDK container whose tools build.sh runs with (see docker-compose.yml). The
# image itself is built from the source above, not from this SDK.
SDK_TAG=ramips-mt7620-main

# --- Who and where

# The extender's name on the network
AP_NAME=wpa7510

# The extender's address on the main router's network, with the size of the network.
# It has to be outside the range the main router hands out by DHCP.
LAN_ADDRESS=192.168.2.4/24

# The main router: the way to the internet, and the DNS server
GATEWAY=192.168.2.1

# Time zone: its name, and the rule behind it, which is the last line of the file
# /usr/share/zoneinfo/<name> on most Linux systems
TIMEZONE=Europe/Lisbon
TIMEZONE_RULE=WET0WEST,M3.5.0/1,M10.5.0

# --- Wi-Fi

# The network's name, the same on both radios. Its password goes into private/.env as
# WIFI_KEY, 8 to 63 characters. Without one, the image comes with Wi-Fi switched off.
WIFI_SSID=OpenWrt

# Two-letter country code, which decides the channels and power allowed
WIFI_COUNTRY=PT

# The 2.4 GHz channel: 1 to 13, or auto to let the extender pick the quietest one when it
# starts. 20 MHz wide.
WIFI_CHANNEL_2G=auto

# The 5 GHz channel, or auto, and its width: VHT20, VHT40 or VHT80. Channels 36 to 48 need
# no radar detection; the others make the extender listen for radar for a minute before
# it starts sending.
WIFI_CHANNEL_5G=auto
WIFI_HTMODE_5G=VHT80
