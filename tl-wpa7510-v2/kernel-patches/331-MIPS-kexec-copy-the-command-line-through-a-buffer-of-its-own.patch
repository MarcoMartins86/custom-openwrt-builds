From: Marco Martins <marcomartins86@gmail.com>
Subject: [PATCH] MIPS: kexec: copy the command line through a buffer of its own

kexec_argv_buf is part of the relocation code, so it is kernel text, and
with HARDENED_USERCOPY the copy_from_user() into it ends in a kernel BUG:

  usercopy: Kernel memory overwrite attempt detected to kernel text

Copy the command line to the stack first, and from there into
kexec_argv_buf. Read the "kexec " prefix of each segment with
copy_from_user() as well, as the segments are user space buffers.

Signed-off-by: Marco Martins <marcomartins86@gmail.com>
---
--- a/arch/mips/kernel/machine_kexec.c
+++ b/arch/mips/kernel/machine_kexec.c
@@ -46,6 +46,7 @@
 
 static void machine_kexec_init_argv(struct kimage *image)
 {
+	char cmdline[KEXEC_COMMAND_LINE_SIZE];
 	void __user *buf = NULL;
 	size_t bufsz;
 	size_t size;
@@ -54,12 +55,15 @@
 	bufsz = 0;
 	for (i = 0; i < image->nr_segments; i++) {
 		struct kexec_segment *seg;
+		char prefix[6];
 
 		seg = &image->segment[i];
-		if (seg->bufsz < 6)
+		if (seg->bufsz < sizeof(prefix))
 			continue;
 
-		if (strncmp((char *) seg->buf, "kexec ", 6))
+		/* seg->buf is a user space address */
+		if (copy_from_user(prefix, seg->buf, sizeof(prefix)) ||
+		    memcmp(prefix, "kexec ", sizeof(prefix)))
 			continue;
 
 		buf = seg->buf;
@@ -75,9 +79,16 @@
 	if (size < bufsz)
 		pr_warn("kexec command line truncated to %zd bytes\n", size);
 
-	/* Copy to kernel space */
-	if (copy_from_user(kexec_argv_buf, buf, size))
+	/*
+	 * Copy to kernel space. kexec_argv_buf is part of the relocation code,
+	 * which is kernel text, and hardened usercopy refuses to copy into
+	 * that: go through a buffer of our own.
+	 */
+	if (copy_from_user(cmdline, buf, size)) {
 		pr_warn("kexec command line copy to kernel space failed\n");
+		return;
+	}
+	memcpy(kexec_argv_buf, cmdline, size);
 
 	kexec_argv_buf[size - 1] = 0;
 }
