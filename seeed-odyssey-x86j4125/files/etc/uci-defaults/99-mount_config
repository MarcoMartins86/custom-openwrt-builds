# https://openwrt.org/docs/guide-user/storage/fstab
# Every boot runs e2fsck -p on the partitions fstab mounts, which here is the
# data partition, before mounting them: a quick look when one is clean, a full
# check with the safe repairs when the kernel has flagged an error on it. The
# root partition is mounted by the kernel and gets no such check. The first
# boot after a flash mounts the data partition itself, in 11-data_partition,
# and runs the same check there.
uci -q batch << EOI
set fstab.@global[0].check_fs="1"
commit fstab
EOI

# The check runs before the system log does, so e2fsck keeps its report in /tmp
# (see /etc/e2fsck.conf) and /etc/init.d/fsck_report hands it to the log.
# disable first: enable adds links but leaves those of an older start number
/etc/init.d/fsck_report disable
/etc/init.d/fsck_report enable

# On reboot and poweroff, whatever still uses the data partition is ended just
# before it is unmounted, so that it is unmounted cleanly
/etc/init.d/release_data disable
/etc/init.d/release_data enable
