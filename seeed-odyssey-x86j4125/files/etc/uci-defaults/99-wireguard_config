# https://openwrt.org/docs/guide-user/services/vpn/wireguard/server
# The VPN server. Devices are added in LuCI, under Network → Interfaces → wg0 → Peers.
# Its key and those devices are kept in /etc/wireguard, where the flash step saves
# them and carries them across a reflash. A router starting without them gets a
# new key and no devices.
. /etc/build.env
mkdir -p /etc/wireguard
chmod 700 /etc/wireguard
[ -s /etc/wireguard/server.key ] || (umask 077; wg genkey > /etc/wireguard/server.key)
# VPN devices get a range and a firewall zone of their own. They may reach the
# router, the LAN and the internet, and LAN devices may reach them. Only the
# VPN's port is opened on the WAN side. Adblock's forced DNS covers them too.
uci -q batch << EOI
set network.wg0=interface
set network.wg0.proto="wireguard"
set network.wg0.private_key="$(cat /etc/wireguard/server.key)"
set network.wg0.listen_port="${VPN_PORT}"
add_list network.wg0.addresses="${VPN_ADDRESS}"
commit network
set firewall.vpn=zone
set firewall.vpn.name="vpn"
set firewall.vpn.input="ACCEPT"
set firewall.vpn.output="ACCEPT"
set firewall.vpn.forward="REJECT"
add_list firewall.vpn.network="wg0"
add firewall forwarding
set firewall.@forwarding[-1].src="vpn"
set firewall.@forwarding[-1].dest="lan"
add firewall forwarding
set firewall.@forwarding[-1].src="vpn"
set firewall.@forwarding[-1].dest="wan"
add firewall forwarding
set firewall.@forwarding[-1].src="lan"
set firewall.@forwarding[-1].dest="vpn"
set firewall.wireguard=rule
set firewall.wireguard.name="Allow-WireGuard"
set firewall.wireguard.src="wan"
set firewall.wireguard.proto="udp"
set firewall.wireguard.dest_port="${VPN_PORT}"
set firewall.wireguard.target="ACCEPT"
commit firewall
add_list adblock.global.adb_nftdevforce="wg0"
commit adblock
EOI
# The DNS server only answers the networks it knows; add the VPN's range
eval "$(ipcalc.sh "${VPN_ADDRESS}")"
echo "access-control: ${NETWORK}/${PREFIX} allow" >> /etc/unbound/unbound_srv.conf
# The saved devices are sections in the format of /etc/config/network
if [ -s /etc/wireguard/peers ]; then
	uci -m import network < /etc/wireguard/peers
fi
