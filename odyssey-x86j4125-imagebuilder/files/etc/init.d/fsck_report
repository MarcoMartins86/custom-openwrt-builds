#!/bin/sh /etc/rc.common
# The partitions fstab mounts are checked at boot before the system log runs, so
# e2fsck leaves its report in /tmp (see 99-mount_config). Once the log is up, this
# hands each report to it, line by line.

START=13

boot() {
	local report
	for report in /tmp/e2fsck-*.log; do
		[ -f "${report}" ] || continue
		logger -t e2fsck < "${report}"
		rm -f "${report}"
	done
}
