#!/bin/sh /etc/rc.common
# Brings up the containers defined in /etc/compose, where every folder is a
# Docker Compose project. The work is done by /usr/libexec/compose-up, which
# may run for a while: it must not be started through this script, whose every
# call waits for the service lock.
# https://docs.docker.com/compose/

START=99
STOP=01
USE_PROCD=1

extra_command "update" "Download newer images and recreate the containers that use them"

last_line() {
	tail -n 1 "/tmp/compose-$1.log" | sed -e 's/^ *//' -e 's/ *$//'
}

# Also run every month by cron, see CONTAINER_UPDATE_DAY. Each project's output
# goes to /tmp/compose-<name>.log, the outcome to the system log.
update() {
	local dir name
	for dir in /etc/compose/*/; do
		[ -f "${dir}docker-compose.yml" ] || continue
		name="$(basename "$dir")"
		if (cd "$dir" && docker-compose pull --quiet && docker-compose up -d) > "/tmp/compose-$name.log" 2>&1; then
			logger -s -t compose "$name updated: $(last_line "$name")"
		else
			logger -s -t compose "$name not updated: $(last_line "$name")"
		fi
	done
	# An update leaves the image it replaced without a name. It stays until it is
	# two months old, so that the version before is there to go back to.
	docker image prune -f --filter "until=1440h" > /dev/null
}

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/compose-up
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# On reboot and poweroff. The Docker service has no stop step of its own, so
# OpenWrt would only end it after trying to unmount the disks, and the data
# partition, which holds Docker's files, would stay mounted to the end. Docker
# is told to stop here instead, first of all: it gives each container its time
# to shut down, then exits. The containers keep their restart policy, as with
# flash.sh. procd allows a stop step 15 seconds, then asks it to end and forces
# it 10 seconds later; the asking is ignored, so Docker gets 20 seconds. What
# still runs after that is ended by /etc/init.d/release_data.
shutdown() {
	local pid i=0
	trap '' TERM
	stop
	pid="$(pidof dockerd)" || return 0
	kill -TERM ${pid}
	while [ $i -lt 20 ] && pidof dockerd containerd containerd-shim-runc-v2 > /dev/null; do
		sleep 1
		i=$((i + 1))
	done
	if [ $i -lt 20 ]; then
		logger -t compose "Docker stopped after ${i}s"
	else
		logger -t compose "Docker still stopping after ${i}s"
	fi
}
