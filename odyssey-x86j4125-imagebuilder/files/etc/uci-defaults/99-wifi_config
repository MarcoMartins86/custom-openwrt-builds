# The built-in Intel card only works as an access point on 2.4 GHz. Keep a
# protected network ready but switched off, for reaching the router without a cable.
# Enable with: uci set wireless.default_radio0.disabled=0; uci commit wireless; wifi up
[ -d /sys/devices/pci0000:00/0000:00:0c.0 ] || exit 0

mkdir -p /etc/odyssey
[ -s /etc/odyssey/wifi.key ] || head -c 9 /dev/urandom | hexdump -v -e '/1 "%02x"' > /etc/odyssey/wifi.key
chmod 600 /etc/odyssey/wifi.key

cat > /etc/config/wireless << EOI
config wifi-device 'radio0'
	option type 'mac80211'
	option path 'pci0000:00/0000:00:0c.0'
	option band '2g'
	option channel '6'
	option htmode 'HT20'
	option cell_density '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'odyssey-admin'
	option encryption 'psk2'
	option key '$(cat /etc/odyssey/wifi.key)'
	option disabled '1'
EOI
