# https://openwrt.org/docs/guide-user/perf_and_log/statistic.collectd
. /etc/build.env
uci -q batch << EOI
set luci_statistics.collectd_rrdtool.CacheTimeout="300"
set luci_statistics.collectd_rrdtool.CacheFlush="3600"
delete luci_statistics.collectd_interface.Interfaces
add_list luci_statistics.collectd_interface.Interfaces="br-lan"
add_list luci_statistics.collectd_interface.Interfaces="eth1"
set luci_statistics.collectd_ping.enable="1"
delete luci_statistics.collectd_ping.Hosts
add_list luci_statistics.collectd_ping.Hosts="1.1.1.1"
set luci_statistics.collectd_thermal.enable="1"
set luci_statistics.collectd_sensors.enable="1"
set luci_statistics.collectd_conntrack.enable="1"
set luci_statistics.collectd_uptime.enable="1"
set luci_statistics.collectd_cpufreq.enable="1"
set luci_statistics.collectd_df.enable="1"
delete luci_statistics.collectd_df.Devices
delete luci_statistics.collectd_df.FSTypes
delete luci_statistics.collectd_df.MountPoints
add_list luci_statistics.collectd_df.MountPoints="/"
add_list luci_statistics.collectd_df.MountPoints="/mnt/data"
set luci_statistics.collectd_disk.enable="1"
delete luci_statistics.collectd_disk.Disks
add_list luci_statistics.collectd_disk.Disks="sda"
delete luci_statistics.collectd_iwinfo.enable
commit luci_statistics
EOI
# History goes to the data partition so it outlives reboots and reflashes
if grep -q " /mnt/data " /proc/mounts; then
	mkdir -p /mnt/data/rrd
	# History recorded before the router got its name
	[ -d /mnt/data/rrd/OpenWrt ] && [ ! -e "/mnt/data/rrd/${ROUTER_NAME}" ] && mv /mnt/data/rrd/OpenWrt "/mnt/data/rrd/${ROUTER_NAME}"
	uci -q batch << EOI
set luci_statistics.collectd_rrdtool.DataDir="/mnt/data/rrd"
commit luci_statistics
EOI
fi
