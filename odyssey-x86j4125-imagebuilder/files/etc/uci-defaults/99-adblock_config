# https://github.com/openwrt/packages/blob/master/net/adblock/README.md
. /etc/build.env
# Feeds that come in categories take the file of each category, which
# /etc/adblock/adblock.categories lists next to its name.
category_files() {
	local feed="$1" name
	shift
	for name in "$@"; do
		awk -F';' -v f="${feed}" -v n="${name}" '$1 == f && $2 == n { print $3 }' /etc/adblock/adblock.categories
	done
}
# The download options are adblock's own for curl, with two changes:
# - --compressed: the server of the divested feed refuses clients that do not
#   ask for a compressed transfer, and the other feeds arrive smaller with it.
# - Two retries instead of four, and only after errors that can pass (a timeout,
#   429 "too many requests" or a server error), waiting 10 seconds, or as long
#   as the server asks. Adblock's own options also retry a refusal such as 403,
#   five requests in a row, which is how servers come to block a router.
#   adb_fetchretry only builds adblock's own options; it is set to match, for
#   LuCI's page.
#
# The downloaded lists are kept on the data partition, so a boot loads them from
# there and needs no network for it. Only a disk without them has to download at
# boot, which is what the delay before adblock starts leaves time for. The
# nightly refresh first asks each server for the list's ETag and downloads only
# the lists that changed.
#
# The DNS report listens on every interface, so that it also shows the devices
# on the VPN and on the WAN side. That alone would mostly catch unbound asking
# the internet's name servers. The filter keeps the lookups that ask for
# recursion, which devices do and unbound does not: the flag is the lowest bit of
# the third byte of a DNS message, at udp[10] over IPv4 and at ip6[50] over IPv6.
# The capture is kept in ten files, the most LuCI accepts.
#
# DNS on port 53 is redirected to the router. For port 853, DNS over TLS, adblock
# rejects the connection instead, so a device set to an encrypted DNS service
# outside fails to connect and cannot go around the blocking.
uci -q batch << EOI
set adblock.global.adb_fetchcmd="curl"
set adblock.global.adb_fetchparm="--compressed --connect-timeout 20 --speed-time 20 --retry-delay 10 --retry 2 --fail --silent --globoff --show-error --location -o"
set adblock.global.adb_fetchretry="3"
set adblock.global.adb_triggerdelay="30"
set adblock.global.adb_backupdir="/mnt/data/adblock/backup"
delete adblock.global.adb_feed
$(for feed in ${ADBLOCK_FEEDS}; do echo "add_list adblock.global.adb_feed=\"${feed}\""; done)
set adblock.global.adb_nftforce="1"
delete adblock.global.adb_nftdevforce
add_list adblock.global.adb_nftdevforce="br-lan"
delete adblock.global.adb_nftportforce
add_list adblock.global.adb_nftportforce="53"
add_list adblock.global.adb_nftportforce="853"
set adblock.global.adb_report="1"
set adblock.global.adb_repiface="any"
set adblock.global.adb_repfilter="udp[10] & 1 != 0 or ip6[50] & 1 != 0 or tcp"
set adblock.global.adb_repchunkcnt="10"
set adblock.global.adb_repchunksize="$((ADBLOCK_REPORT_MB / 10))"
set adblock.global.adb_map="${ADBLOCK_MAP:-0}"
delete adblock.global.adb_hag_feed
$(for file in $(category_files hag ${ADBLOCK_HAGEZI_CATEGORIES}); do echo "add_list adblock.global.adb_hag_feed=\"${file}\""; done)
delete adblock.global.adb_stb_feed
$(for file in $(category_files stb ${ADBLOCK_STEVENBLACK_CATEGORIES}); do echo "add_list adblock.global.adb_stb_feed=\"${file}\""; done)
delete adblock.global.adb_utc_feed
$(for category in ${ADBLOCK_UTCAPITOLE_CATEGORIES}; do echo "add_list adblock.global.adb_utc_feed=\"${category}\""; done)
commit adblock
EOI

# Adblock only downloads its lists again when told to reload
CRON="/etc/crontabs/root"
[ -f "${CRON}" ] && sed -i '\|/etc/init.d/adblock reload|d' "${CRON}"
if [ -n "${ADBLOCK_REFRESH_HOUR}" ]; then
	echo "0 ${ADBLOCK_REFRESH_HOUR} * * * /etc/init.d/adblock reload" >> "${CRON}"
fi
