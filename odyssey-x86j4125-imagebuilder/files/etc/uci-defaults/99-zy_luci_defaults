# Statistics → Setup: the page itself, then the plugins' dialogs
uci -q batch << EOI
set luci_statistics.collectd.Include="/etc/collectd/conf.d/*.conf"
set luci_statistics.collectd_mqtt=statistics
delete luci_statistics.collectd_network.enable
delete luci_statistics.collectd_df.IgnoreSelected
delete luci_statistics.collectd_df.ValuesPercentage
delete luci_statistics.collectd_disk.IgnoreSelected
delete luci_statistics.collectd_interface.IgnoreSelected
delete luci_statistics.collectd_thermal.IgnoreSelected
delete luci_statistics.collectd_memory.ValuesAbsolute
delete luci_statistics.collectd_memory.ValuesPercentage
set luci_statistics.collectd_ping.AddressFamily="any"
delete luci_statistics.collectd_rrdtool.backup
delete luci_statistics.collectd_rrdtool.RRATimespans
add_list luci_statistics.collectd_rrdtool.RRATimespans="2hour"
add_list luci_statistics.collectd_rrdtool.RRATimespans="1day"
add_list luci_statistics.collectd_rrdtool.RRATimespans="1week"
add_list luci_statistics.collectd_rrdtool.RRATimespans="1month"
add_list luci_statistics.collectd_rrdtool.RRATimespans="1year"
EOI
uci commit
