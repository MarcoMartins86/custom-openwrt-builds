# LuCI stores some settings only once a page or dialog has been saved: values it
# shows as defaults, old option names it renames, and options it removes because
# they equal its defaults. They then appear as unrequested changes next to the
# one that was meant. Everything here is what LuCI would store by itself, or the
# value already in effect written out, so the router behaves as before and LuCI
# is left with nothing to add. Found by saving every page and dialog of LuCI
# unchanged in the test VM. Runs after the scripts that create the sections.
. /lib/functions.sh

# Network → Interfaces: the page itself, then each interface's dialog
luci_interface() {
	[ "$1" = loopback ] || uci -q set network."$1".multipath="off"
}
config_load network
config_foreach luci_interface interface
uci -q batch << EOI
set network.globals.packet_steering="1"
set network.wan.sendclientid="auto"
set network.wan6.reqaddress="try"
set network.wan6.reqprefix="auto"
set network.wan6.sendclientid="auto"
set network.wan6.norelease="0"
delete dhcp.lan.ra_slaac
set dhcp.lan.ipv6_only_preferred="0"
set dhcp.lan.ra_preference="medium"
delete dhcp.lan.domain
add_list dhcp.lan.domain="lan"
EOI

# Network → Firewall: the old name of the SYN flood switch, and every rule
luci_rule() {
	uci -q get firewall."$1".enabled > /dev/null || uci -q set firewall."$1".enabled="1"
}
config_load firewall
config_foreach luci_rule rule
uci -q batch << EOI
delete firewall.@defaults[0].syn_flood
set firewall.@defaults[0].synflood_protect="1"
EOI

# System → System and System → Administration
uci -q batch << EOI
delete system.ntp.enabled
delete system.ntp.enable_server
set system.@system[0].log_proto="udp"
set system.@system[0].conloglevel="7"
set system.@system[0].cronloglevel="7"
delete dropbear.main.enable
EOI

