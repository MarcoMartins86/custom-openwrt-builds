# https://github.com/openwrt/packages/blob/master/net/banip/files/README.md
# The default feeds are a conservative start: three inbound attacker lists and
# two high-confidence lists that also apply outbound.
. /etc/build.env
uci -q batch << EOI
set banip.global.ban_enabled="1"
delete banip.global.ban_feed
$(for feed in ${BANIP_FEEDS}; do echo "add_list banip.global.ban_feed=\"${feed}\""; done)
commit banip
EOI
