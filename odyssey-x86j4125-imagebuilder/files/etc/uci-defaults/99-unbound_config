# https://openwrt.org/docs/guide-user/base-system/dhcp_configuration#replacing_dnsmasq_with_odhcpd_and_unbound
# https://github.com/openwrt/packages/blob/master/net/unbound/files/README.md
# "enabled" has to be spelled out: without it, LuCI's page for this service
# shows it switched off and stops the DNS server when the page is saved.
# unbound resolves by itself, from the root servers, so nothing on the WAN side
# concerns it: the package's default also restarts it on every event of the WAN,
# which during an outage is twice per watchcat restart, each time emptying its
# cache and fetching the root zone's DNSSEC key again over whatever link is left.
uci -q batch << EOI
set unbound.@unbound[0].enabled="1"
set unbound.@unbound[0].add_local_fqdn="3"
set unbound.@unbound[0].add_wan_fqdn="1"
set unbound.@unbound[0].dhcp_link="odhcpd"
set unbound.@unbound[0].dhcp4_slaac6="1"
set unbound.@unbound[0].unbound_control="1"
set unbound.@unbound[0].validator="1"
delete unbound.@unbound[0].iface_trig
add_list unbound.@unbound[0].iface_trig="lan"
commit unbound
set dhcp.odhcpd.leasetrigger="/usr/lib/unbound/odhcpd.sh"
commit dhcp
EOI
# Behind another router, the devices on that one's network may use this DNS
# server too, if WAN_DNS_CLIENTS names their network. The firewall lets DNS in
# from there and nowhere else on the WAN side, and the DNS server, which only
# answers the networks it knows, gets that one added.
. /etc/build.env
if [ -n "${WAN_DNS_CLIENTS}" ]; then
	echo "access-control: ${WAN_DNS_CLIENTS} allow" >> /etc/unbound/unbound_srv.conf
	uci -q batch << EOI
set firewall.wan_dns=rule
set firewall.wan_dns.name="Allow-DNS-WAN-side"
set firewall.wan_dns.src="wan"
set firewall.wan_dns.src_ip="${WAN_DNS_CLIENTS}"
add_list firewall.wan_dns.proto="tcp"
add_list firewall.wan_dns.proto="udp"
set firewall.wan_dns.dest_port="53"
set firewall.wan_dns.target="ACCEPT"
commit firewall
EOI
fi

# Without IPv6 to the internet, unbound must not ask name servers over IPv6.
# Those queries never get an answer, yet look faster than the real answers when
# the link is slow (a tethered phone takes a second or more), so unbound keeps
# choosing them and returns SERVFAIL; github.com did, on 2026-10-28.
if [ "${IPV6}" != 1 ]; then
	uci -q set unbound.@unbound[0].protocol="ip4_only"
	uci -q commit unbound
fi
