# Everything that can be chosen about the image. docker-compose.yml, build.sh, flash.sh and
# the test scripts read this file. Your own values, and anything private, go into
# private/.env, which overrides this file and is not in the repo.
#
# The format has to suit both the shell and Docker Compose: NAME=value with no spaces around
# the "=", and double quotes around a value that contains spaces.

# --- Build

# OpenWrt release; it selects the ImageBuilder container ghcr.io/openwrt/imagebuilder:x86-64-v<version>
OPENWRT_VERSION=25.12.6

# ImageBuilder profile, see `make info` inside the container
PROFILE=generic

# Root partition size in MB. It is fixed on purpose, see "Disk layout" in the README.
ROOTFS_PARTSIZE=2048

# Which images to build: the file systems ext4 and squashfs, the boot methods efi and bios,
# and targz for the root file system as an archive. One image comes out per file system and
# boot method, so "ext4 squashfs efi bios" makes four. Each one adds to the build time.
# flash.sh and the test scripts look for the ext4 image that boots with EFI.
IMAGE_KINDS="ext4 efi"

# --- Who and where

# The router's name on the network. Its HTTPS certificate is issued to <name>.lan.
ROUTER_NAME=odyssey

# The router's address on the LAN, with the size of the network
LAN_ADDRESS=192.168.2.1/24

# 1 keeps OpenWrt's IPv6: the router asks the WAN side for it and hands out IPv6 addresses
# on the LAN, local ones for as long as the WAN side offers none. 0 switches both off, for
# an internet connection without IPv6.
IPV6=0

# Time zone, by the name LuCI lists under System → System
TIMEZONE=Europe/Lisbon

# --- DNS for the network in front of the router

# When this router sits behind another one, the devices on that one's network can use this
# router's DNS, and with it the ad blocking. Name their network here, for example
# 192.168.1.0/24, and make the other router hand out this router's WAN address as DNS
# server. Empty keeps DNS closed on the WAN side.
WAN_DNS_CLIENTS=

# --- Wi-Fi

# Name of the protected network that is kept ready but switched off
WIFI_SSID=odyssey-admin

# --- VPN

# UDP port the WireGuard server listens on, and its address in the range VPN devices get
VPN_PORT=51820
VPN_ADDRESS=10.8.0.1/24

# --- Blocklists

# Adblock feeds, by the names in /etc/adblock/adblock.feeds. Adblock merges them into one
# list without repeats, so overlapping feeds cost nothing at lookup time.
ADBLOCK_FEEDS="adguard_tracking android_tracking andryou anti_ad anudeep certpl cpbl divested doh_blocklist firetv_tracking hagezi hblock oisd_big smarttv_tracking stevenblack stopforumspam utcapitole"

# Three of those feeds come in categories and are skipped without a choice. The names are
# the ones in the second column of /etc/adblock/adblock.categories.
ADBLOCK_HAGEZI_CATEGORIES="multi-pro threat-intelligence.medium doh"
ADBLOCK_STEVENBLACK_CATEGORIES="standard"
ADBLOCK_UTCAPITOLE_CATEGORIES="publicite malware phishing cryptojacking stalkerware ddos"

# Hour of the night, 0 to 23, at which adblock downloads its lists again. Empty never does,
# and the lists then stay as old as their first download.
ADBLOCK_REFRESH_HOUR=5

# How many MB of DNS traffic adblock keeps in memory for its DNS report: 10 to 100, in steps
# of 10. The report reaches back as far as this lasts; a few devices fill 1 to 3 MB an hour.
ADBLOCK_REPORT_MB=100

# 1 shows blocked domains on a map in adblock's DNS report. For that the router sends the
# addresses of those domains to ip-api.com.
ADBLOCK_MAP=1

# banIP feeds, by the names in /etc/banip/banip.feeds. Never add "bogon" while the WAN side
# is a private network behind another router.
BANIP_FEEDS="cinsscore debl dshield feodo threat"

# Hour of the night, 0 to 23, at which banIP checks its feeds for newer lists, at half past.
# Empty never does, and the lists then stay as old as their first download.
BANIP_REFRESH_HOUR=4

# --- File sharing

# Network name of one folder offered to everyone on the LAN, without a password, as
# \\<router>\<name>. Empty switches file sharing off.
GUEST_SHARE=share

# --- Dynamic DNS

# So that VPN devices find the router from outside, a name at a dynamic DNS provider follows
# the home's public address. These belong in private/.env; without them it stays off.
# The provider is one of the names in /usr/share/ddns/default on the router, without ".json".
# DDNS_USER is only for providers that ask for an account name next to the token.
#DDNS_PROVIDER=duckdns.org
#DDNS_HOST=name.duckdns.org
#DDNS_USER=
#DDNS_TOKEN=

# --- Home Assistant

# 1 runs Home Assistant as a container
HOME_ASSISTANT=1

# The Zigbee stick handed to it, or empty for none. The container does not start while a
# device named here is missing.
ZIGBEE_DEVICE=/dev/ttyUSB0

# Day of the month, 1 to 28, on which the containers switch to the newest images of their
# tags, at 04:00. By mid-month Home Assistant's monthly release has had its first fixes.
# Empty leaves updates to /etc/init.d/compose update, run by hand.
CONTAINER_UPDATE_DAY=15

# --- LuCI

# Theme LuCI starts with: the name of its folder under /www/luci-static
LUCI_THEME=argon
