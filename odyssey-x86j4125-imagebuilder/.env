# Everything that can be chosen about the image. docker-compose.yml, build.sh, flash.sh and
# the test scripts read this file. Your own values, and anything private, go into
# private/.env, which overrides this file and is not in the repo.
#
# The format has to suit both the shell and Docker Compose: NAME=value with no spaces around
# the "=", and double quotes around a value that contains spaces.

# --- Build

# OpenWrt release; it selects the ImageBuilder container ghcr.io/openwrt/imagebuilder:x86-64-v<version>
OPENWRT_VERSION=25.12.5

# ImageBuilder profile, see `make info` inside the container
PROFILE=generic

# Root partition size in MB. It is fixed on purpose, see "Disk layout" in the README.
ROOTFS_PARTSIZE=2048

# --- Who and where

# The router's name on the network. Its HTTPS certificate is issued to <name>.lan.
ROUTER_NAME=odyssey

# The router's address on the LAN, with the size of the network
LAN_ADDRESS=192.168.2.1/24

# Time zone, by the name LuCI lists under System → System
TIMEZONE=Europe/Lisbon

# --- Wi-Fi

# Name of the protected network that is kept ready but switched off
WIFI_SSID=odyssey-admin

# --- VPN

# UDP port the WireGuard server listens on, and its address in the range VPN devices get
VPN_PORT=51820
VPN_ADDRESS=10.8.0.1/24

# --- Blocklists

# Adblock feeds, by the names in /etc/adblock/adblock.feeds
ADBLOCK_FEEDS="adguard adguard_tracking android_tracking andryou anti_ad anudeep bitcoin cpbl disconnect doh_blocklist firetv_tracking games_tracking hblock oisd_big oisd_small phishing_army smarttv_tracking spam404 stevenblack stopforumspam utcapitole wally3k whocares winspy yoyo"

# Categories taken from the utcapitole feed
ADBLOCK_UTC_CATEGORIES="publicite malware phishing cryptojacking stalkerware ddos"

# 1 shows blocked domains on a map in adblock's DNS report. For that the router sends the
# addresses of those domains to ip-api.com.
ADBLOCK_MAP=1

# banIP feeds, by the names in /etc/banip/banip.feeds. Never add "bogon" while the WAN side
# is a private network behind another router.
BANIP_FEEDS="cinsscore debl dshield feodo threat"

# --- File sharing

# Network name of one folder offered to everyone on the LAN, without a password, as
# \\<router>\<name>. Empty switches file sharing off.
GUEST_SHARE=share

# --- Dynamic DNS

# So that VPN devices find the router from outside, a name at a dynamic DNS provider follows
# the home's public address. These belong in private/.env; without them it stays off.
# The provider is one of the names in /usr/share/ddns/default on the router, without ".json".
# DDNS_USER is only for providers that ask for an account name next to the token.
#DDNS_PROVIDER=duckdns.org
#DDNS_HOST=name.duckdns.org
#DDNS_USER=
#DDNS_TOKEN=

# --- Home Assistant

# 1 runs Home Assistant as a container
HOME_ASSISTANT=1

# The Zigbee stick handed to it, or empty for none. The container does not start while a
# device named here is missing.
ZIGBEE_DEVICE=/dev/ttyUSB0

# --- LuCI

# Theme LuCI starts with: the name of its folder under /www/luci-static
LUCI_THEME=argon
