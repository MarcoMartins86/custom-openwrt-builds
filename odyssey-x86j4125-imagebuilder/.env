# The pinned inputs of the build. docker-compose.yml and build.sh both read this file.

# OpenWrt release; it selects the ImageBuilder container ghcr.io/openwrt/imagebuilder:x86-64-v<version>
OPENWRT_VERSION=25.12.5

# ImageBuilder profile, see `make info` inside the container
PROFILE=generic

# Root partition size in MB. It is fixed on purpose, see "Disk layout" in the README.
ROOTFS_PARTSIZE=2048
