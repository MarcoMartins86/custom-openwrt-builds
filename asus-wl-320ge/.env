# Everything that can be chosen about the image. docker-compose.yml, build.sh and flash.sh
# read this file. Your own values, and anything private, go into private/.env, which
# overrides this file and is not in the repo.
#
# The format has to suit both the shell and Docker Compose: NAME=value with no spaces around
# the "=", and double quotes around a value that contains spaces. A password goes in single
# quotes: unquoted, the shell acts on characters such as & ; | and spaces, and inside double
# quotes still on $, \ and backticks. A ' in it is written '\''.

# --- Build

# OpenWrt release. build.sh builds it from OpenWrt's source at the tag v<version>, in the
# SDK container ghcr.io/openwrt/sdk:bcm47xx-legacy-v<version>, which has the tools for it.
OPENWRT_VERSION=25.12.6

# Where the source comes from
OPENWRT_GIT=https://github.com/openwrt/openwrt.git

# --- Who and where

# The access point's name on the network
AP_NAME=wl320ge

# The access point's address on the main router's network, with the size of the network.
# It has to be outside the range the main router hands out by DHCP.
LAN_ADDRESS=192.168.2.3/24

# The main router: the way to the internet, and the DNS server
GATEWAY=192.168.2.1

# Time zone: its name, and the rule behind it, which is the last line of the file
# /usr/share/zoneinfo/<name> on most Linux systems
TIMEZONE=Europe/Lisbon
TIMEZONE_RULE=WET0WEST,M3.5.0/1,M10.5.0

# --- Wi-Fi

# The network's name. Its password goes into private/.env as WIFI_KEY, 8 to 63 characters.
# Without one, the image comes with Wi-Fi switched off.
WIFI_SSID=OpenWrt

# Two-letter country code, which decides the channels and power allowed
WIFI_COUNTRY=PT

# 1 to 13. The Wi-Fi driver cannot survey the channels, so the access point cannot pick a
# quiet one itself; 1, 6 and 11 do not overlap. As a repeater (below) it has to be the
# upstream's channel, since the one radio carries both the access point and the uplink.
WIFI_CHANNEL=11

# --- Repeater

# Set to 1 to also join the Wi-Fi above as a client and extend it, instead of only serving
# it. The access point and the uplink then share the one radio on WIFI_CHANNEL, which has
# to be the upstream's. Needs WIFI_KEY. Empty (the default) is a plain access point.
REPEATER=

# The upstream to extend, by its BSSID (the MAC of the router or extender to repeat), like
# b0:95:75:9b:4d:dc. Optional: empty lets the uplink pick the strongest with the SSID
# above, which may be the wrong one where several broadcast the same name.
UPLINK_BSSID=
