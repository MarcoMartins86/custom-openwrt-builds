#!/bin/sh /etc/rc.common
# The access point: hostapd with the configuration build.sh wrote to /etc/hostapd.conf,
# which also puts the Wi-Fi in the LAN bridge. An image built without a Wi-Fi password
# has none, and comes with Wi-Fi off.

START=96
USE_PROCD=1

start_service() {
	[ -s /etc/hostapd.conf ] || return 0
	iw phy phy0 interface add phy0-ap0 type __ap 2> /dev/null
	procd_open_instance
	procd_set_param command /usr/sbin/hostapd /etc/hostapd.conf
	procd_set_param respawn
	procd_close_instance
}
