#!/bin/sh /etc/rc.common
# The access point: hostapd with the configuration build.sh wrote to /etc/hostapd.conf,
# which also puts the Wi-Fi in the LAN bridge. An image built without a Wi-Fi password
# has none, and comes with Wi-Fi off.

START=96
USE_PROCD=1

start_service() {
	[ -s /etc/hostapd.conf ] || return 0
	# The Wi-Fi queues may hold 16 MB by default, all of this device's memory: when the air
	# is slower than the traffic coming in, they would fill it. 512 KB still buffers over
	# 100 ms at the radio's best.
	iw phy phy0 set txq memory_limit 524288
	iw phy phy0 interface add phy0-ap0 type __ap 2> /dev/null
	# Restarted however often it stops: there is no one to restart it by hand
	procd_open_instance
	procd_set_param command /usr/sbin/hostapd /etc/hostapd.conf
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
