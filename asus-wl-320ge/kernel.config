# Kernel options on top of those for OpenWrt's bcm47xx/legacy devices, which this image's
# kernel is built with. build.sh appends them to target/linux/bcm47xx/legacy/config-default
# in the source, and stops when one did not make it into the kernel's configuration.
# Measured on the memory map, see "Memory" in the README.

# Programs loaded into the kernel; nothing on the image uses them
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# ethtool's newer interface; netifd uses the older one
# CONFIG_ETHTOOL_NETLINK is not set
# System V shared memory and semaphores
# CONFIG_SYSVIPC is not set
# VLANs inside the bridge; the switch makes the VLANs here. Needs
# kernel-patches/999-net-bridge-accept-vlan-filtering-off.patch, or netifd makes no bridge.
# CONFIG_BRIDGE_VLAN_FILTERING is not set
# Voltage regulators and bit-banged MDIO buses, which this device has none of
# CONFIG_REGULATOR is not set
# CONFIG_MDIO_GPIO is not set
# CONFIG_MDIO_BITBANG is not set
# No PCI on this board, and its GPIOs only through kernel drivers (the sysfs interface
# brings the character device along)
# CONFIG_PCI is not set
# CONFIG_GPIO_SYSFS is not set
# CONFIG_GPIO_CDEV is not set

# Only the exports the image's modules use, listed in ksyms-keep.txt (build.sh adds its
# path): 585 KB less kernel in memory
CONFIG_TRIM_UNUSED_KSYMS=y

# Smaller memory allocator and tables
CONFIG_SLUB_TINY=y
CONFIG_BASE_SMALL=y
# What the kernel says is kept in 8 KB; logd keeps a copy, so this only has to hold what
# comes before logd starts. With its index, 15 (WR941) would take 100 KB more.
CONFIG_LOG_BUF_SHIFT=13
# The table that randomises the source ports of outgoing TCP connections: 256 entries
# instead of 65536 (256 KB). An access point barely makes outgoing connections.
CONFIG_INET_TABLE_PERTURB_ORDER=8
# Multicast snooping in the bridge, which netifd leaves off by default anyway
# CONFIG_BRIDGE_IGMP_SNOOPING is not set
# The smaller CRC32 tables; the network chips compute their own checksums
# CONFIG_CRC32_SLICEBY8 is not set
CONFIG_CRC32_SARWATE=y
# Traffic control and policy routing; the Wi-Fi stack keeps its own queues
# CONFIG_NET_SCHED is not set
# CONFIG_IP_ADVANCED_ROUTER is not set
# Disk partition tables, an initial RAM disk, SYN cookies and the CUBIC TCP algorithm
# CONFIG_MSDOS_PARTITION is not set
# CONFIG_EFI_PARTITION is not set
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_SYN_COOKIES is not set
# CONFIG_TCP_CONG_CUBIC is not set
CONFIG_DEFAULT_RENO=y

# Stateless: the settings come only from the image. No settings partition is split off
# the root file system, so nothing writes to the flash outside a firmware upgrade, and
# no file system for one (files/lib/preinit/80_mount_root).
# CONFIG_MTD_SPLIT_SQUASHFS_ROOT is not set
# CONFIG_JFFS2_FS is not set

# The kernel command line, with a small TCP metrics table (8192 entries, 32 KB, by default)
CONFIG_CMDLINE="noinitrd console=ttyS0,115200 tcpmhash_entries=16"
