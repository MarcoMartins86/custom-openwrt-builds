# Kernel options on top of those for OpenWrt's ath79/tiny devices, which this image's
# kernel is built with. build.sh appends them to target/linux/ath79/tiny/config-default
# in the source, and stops when one did not make it into the kernel's configuration.
# Together with the kernel options in openwrt.config they make the kernel 705 KB smaller.

# Programs loaded into the kernel; nothing on the image uses them
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# ethtool's newer interface; netifd uses the older one
# CONFIG_ETHTOOL_NETLINK is not set
# System V shared memory and semaphores
# CONFIG_SYSVIPC is not set
# VLANs: the switch marks each port's frames with a trailer instead (DSA), and the bridge
# sets up none
# CONFIG_VLAN_8021Q is not set
# Needs kernel-patches/999-net-bridge-accept-vlan-filtering-off.patch, or netifd makes no
# bridge
# CONFIG_BRIDGE_VLAN_FILTERING is not set
# Parallel flash chips; this device has a serial one
# CONFIG_MTD_CFI is not set
# CONFIG_MTD_JEDECPROBE is not set
# CONFIG_MTD_COMPLEX_MAPPINGS is not set
# CONFIG_MTD_PHYSMAP is not set
# Firmware layouts of other vendors; this device's is TP-Link's
# CONFIG_MTD_SPLIT_SEAMA_FW is not set
# CONFIG_MTD_SPLIT_WRGG_FW is not set
# CONFIG_MTD_SPLIT_UIMAGE_FW is not set
# CONFIG_MTD_SPLIT_LZMA_FW is not set
# CONFIG_MTD_SPLIT_ELF_FW is not set
# CONFIG_MTD_PARSER_CYBERTAN is not set
# The serial port of other Atheros chips; this one has the standard 8250
# CONFIG_SERIAL_AR933X is not set
# Voltage regulators and bit-banged MDIO buses, which this device has none of
# CONFIG_REGULATOR is not set
# CONFIG_REGULATOR_FIXED_VOLTAGE is not set
# CONFIG_MDIO_GPIO is not set
# CONFIG_MDIO_BITBANG is not set
# What the kernel says is kept in 32 KB of memory instead of 128 KB, which with the index
# the kernel keeps of it saves 396 KB. logd keeps a copy, so this only has to hold what
# comes before logd starts.
CONFIG_LOG_BUF_SHIFT=15
# Smaller memory allocator and tables, for 32 MB of memory
CONFIG_SLUB_TINY=y
CONFIG_BASE_SMALL=y
# No PCI on this chip, whose Wi-Fi sits on its own bus, and its GPIOs only through kernel
# drivers (the sysfs interface brings the character device along)
# CONFIG_PCI is not set
# CONFIG_GPIO_SYSFS is not set
# CONFIG_GPIO_CDEV is not set
# Only the exports the image's modules use, listed in ksyms-keep.txt (build.sh adds its
# path). The image has no package manager, so no other module comes to need one.
CONFIG_TRIM_UNUSED_KSYMS=y
# Multicast snooping in the bridge, which netifd leaves off by default anyway
# CONFIG_BRIDGE_IGMP_SNOOPING is not set
# Policy routing, disk partition tables and an initial RAM disk, which an access point
# booting from flash does without
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_MSDOS_PARTITION is not set
# CONFIG_EFI_PARTITION is not set
# CONFIG_BLK_DEV_INITRD is not set

# Stateless: the settings come only from the image. No settings partition is split off
# the root file system, so nothing writes to the flash outside a firmware upgrade, and
# no file system for one (files/lib/preinit/80_mount_root).
# CONFIG_MTD_SPLIT_SQUASHFS_ROOT is not set
# CONFIG_JFFS2_FS is not set
# The root is the squashfs alone; OpenWrt's default also names jffs2
CONFIG_CMDLINE="rootfstype=squashfs"
