# Everything that can be chosen about the image. docker-compose.yml, build.sh, flash.sh and
# the test scripts read this file. Your own values, and anything private, go into
# private/.env, which overrides this file and is not in the repo.
#
# The format has to suit both the shell and Docker Compose: NAME=value with no spaces around
# the "=", and double quotes around a value that contains spaces.

# --- Build

# OpenWrt release. build.sh builds it from OpenWrt's source at the tag v<version>, in the
# SDK container ghcr.io/openwrt/sdk:ath79-tiny-v<version>, which has the tools for it.
OPENWRT_VERSION=25.12.6

# Where the source comes from
OPENWRT_GIT=https://github.com/openwrt/openwrt.git

# --- Who and where

# The access point's name on the network
AP_NAME=wr941

# The access point's address on the main router's network, with the size of the network.
# It has to be outside the range the main router hands out by DHCP.
LAN_ADDRESS=192.168.2.2/24

# The main router: the way to the internet, and the DNS server
GATEWAY=192.168.2.1

# Time zone: its name, and the rule behind it, which is the last line of the file
# /usr/share/zoneinfo/<name> on most Linux systems
TIMEZONE=Europe/Lisbon
TIMEZONE_RULE=WET0WEST,M3.5.0/1,M10.5.0

# --- Wi-Fi

# The network's name. Its password goes into private/.env as WIFI_KEY, 8 to 63 characters.
# Without one, the image comes with Wi-Fi switched off.
WIFI_SSID=OpenWrt

# Two-letter country code, which decides the channels and power allowed
WIFI_COUNTRY=PT

# 1 to 13, or auto to let the access point pick the quietest one when it starts
WIFI_CHANNEL=auto
